      wrap: true
      text: <p><span style="color:#0D9488;font-size:12px;font-family:Consolas;font-weight:700">x_c</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 256, H/16, W/16]</span></p><p><span style="color:#475569;font-size:10px;font-family:Calibri">    Encoder 瓶颈特征 (已经过 FFC + HFE)</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#0D9488;font-size:12px;font-family:Consolas;font-weight:700">x_bb_4</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 512, H/16, W/16]</span></p><p><span style="color:#475569;font-size:10px;font-family:Calibri">    Encoder 深层 skip (CrossModalFusion + TopDown 精炼后)</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#10B981;font-size:12px;font-family:Consolas;font-weight:700">enh1</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 128, H/16, W/16]</span></p><p><span style="color:#475569;font-size:10px;font-family:Calibri">    EnhancementLayers Unit 1 输出</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#DB2777;font-size:12px;font-family:Consolas;font-weight:700">original x</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 1, H, W]</span></p><p><span style="color:#475569;font-size:10px;font-family:Calibri">    用于 SpecularAwareAttention sa1</span></p>
    sourceLayout: 8c6d22eab2a7cef32f2e18f0e24aa23eac055f29d29631c0a00086b18514e9f3
