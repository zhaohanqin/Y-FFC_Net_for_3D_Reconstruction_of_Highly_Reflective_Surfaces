      - 352.8
    content:
      fontFamily: Calibri
      fontSize: 12
      color: '#0D9488'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">L1 输出特征</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  形状: [B, 1408, H/16, W/16]</span></p><p><span style="color:#475569;font-size:10px;font-family:Consolas">  组成: 768 + 512 + 128</span></p><p><span style="color:#475569;font-size:9.5px;font-family:Calibri">  = 解码主体 + gated x_bb_4 + enh1</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#7C3AED;font-size:12px;font-family:Calibri;font-weight:700">本级特点</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · 不做空间上采, 保持 H/16 分辨率</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · 重型频域处理 (双 FFC + 多尺度)</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · 不做三路先验调制 (只用 sa1)</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#DB2777;font-size:12px;font-family:Calibri;font-weight:700">去向</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  → Level 2 (H/8) TransposedConvBlock ↑×2</span></p>'
    sourceLayout: 19042af36454c6b19fc10be5d85bafe2fb04632d8cfc95673457c4b276098c62
