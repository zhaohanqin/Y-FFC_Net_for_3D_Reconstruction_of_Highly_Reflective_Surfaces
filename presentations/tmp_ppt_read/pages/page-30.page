  - elementId: slide-30-node-728-Text-13
    elementType: text
    bounds:
      - 363.6
      - 151.2
      - 280.8
      - 334.8
    content:
      fontFamily: Consolas
      fontSize: 10
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 起点</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = FFC1(x_c)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = FFC2(x)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = x + x_c          # residual</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 多尺度卷积</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = MultiscaleConvBlock(x)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   1x1-&gt;7x7 + 3x3 + 1x1-&gt;3x3-&gt;3x3</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   3 路 cat -&gt; 576 通道</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># Same-size 转置 (不上采)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = TransposedConvBlock_same(x)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   3 路 3x3 卷积分支 cat</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   -&gt; 768 通道</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 高光感知 (sa1)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = SpecularAwareAttention(x, x_orig)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   构造多级高光软 mask</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   x = x * (1 + gamma * attention)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># Skip 门控 (att1)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">gated_xbb4 = Attention_block(x, x_bb_4)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   psi = sigmoid(...)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   gated = x_bb_4 * psi   (512 ch)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 输出</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = cat(x, gated_xbb4, enh1)</span></p>'
    sourceLayout: 9080c7cabf51dd66aa8b1cf53b4d4469e76cbe9a7dad374db48387847a9141e1
