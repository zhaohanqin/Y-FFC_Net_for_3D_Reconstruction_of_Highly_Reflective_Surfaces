    content:
      fontFamily: Consolas
      fontSize: 12
      color: '#F59E0B'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#F59E0B;font-size:12px;font-family:Consolas;font-weight:700">load_model(path, device, prefer_ema=True)</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  ① torch.load → 兼容完整 checkpoint 与纯 state_dict</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  ② 构建 YFFC(swin_pretrained=False)</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  ③ 检测 checkpoint 是否使用 GroupNorm → replace_bn_with_gn</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  ④ 若存在 EMA 且 prefer_ema=True → 合并 EMA 权重</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  ⑤ _load_state_dict_flexible: 优先 strict, 失败时筛选兼容张量按 strict=False 加载</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#F59E0B;font-size:12px;font-family:Consolas;font-weight:700">load_image(path, target_size=None)</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  PIL.open → 转灰度 L → 可选 resize → numpy float32 / 255 → torch [1,1,H,W]</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#F59E0B;font-size:12px;font-family:Consolas;font-weight:700">resolve_patch_size_from_checkpoint</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  优先读取 checkpoint[''image_size'']; 若与脚本配置不一致, 使用 checkpoint 中的尺寸滑窗</span></p>'
    sourceLayout: 0b89bad55049d2f9bbb138a48f6d3a38f4a143ffe00a5176179b8f6bd23b7581
