  - elementId: slide-34-node-804-Text-13
    elementType: text
    bounds:
      - 363.6
      - 151.2
      - 280.8
      - 334.8
    content:
      fontFamily: Consolas
      fontSize: 10
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 空间上采到全分辨率</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = TransposedConvBlock(L4_out)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   -&gt; 48 通道, H, W</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 拼接梯度图作为额外通道</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = cat([x, g_full_res], dim=1)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   -&gt; 49 通道</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 通道压缩</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = output_reduce(x)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   -&gt; 32 通道</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 空洞卷积扩感受野</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x_d = output_dilated(x)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = x + x_d              # 残差</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 进一步压缩</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = output_conv3(x)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   -&gt; 16 通道</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 三个并行输出头</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">b           = sigmoid(b_head(x))</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">r_direct    = sigmoid(r_direct_head(x))</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">alpha_logit = alpha_head(x)  # 不经 sigmoid</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">return (b, r_direct, alpha_logit)</span></p>'
    sourceLayout: 6c92a0611439a814d01c2cac5deb65e939a99199d06ba3e0d5ed1c34db3f1c77
