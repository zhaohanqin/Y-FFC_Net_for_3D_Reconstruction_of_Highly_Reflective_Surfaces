      text: '<p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 接口签名</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">FourierUnit(in_channels, out_channels,</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">            spatial_scale_factor=None,</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">            spectral_pos_encoding=False)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 张量流</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x         : [B, C_in,  H, W]</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">ffted     : [B, 2*C_in, H, W//2 + 1]  # 频域</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">conv1x1   : [B, 2*C_out, ...]</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">iRFFT     : [B, C_out, H, W]          # 回空间</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">output    : [B, C_out, H, W]</span></p>'
