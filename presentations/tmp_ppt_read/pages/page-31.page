        - top
      wrap: true
      text: <p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">L1 输出</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 1408, H/16, W/16]</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#0D9488;font-size:12px;font-family:Consolas;font-weight:700">x_bb_3</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 256, H/8, W/8]</span></p><p><span style="color:#475569;font-size:10px;font-family:Calibri">    Encoder H/8 skip (含 Swin 上下文)</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#10B981;font-size:12px;font-family:Consolas;font-weight:700">enh2</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 64, H/8, W/8]</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#DB2777;font-size:12px;font-family:Consolas;font-weight:700">g, s, x</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 1, H, W] 各一份</span></p><p><span style="color:#475569;font-size:10px;font-family:Calibri">    会被 resize 到 H/8 用于三路门控与 sa2</span></p>
    sourceLayout: 2db8f7297456bc162f4f2797f2fb07485931a7ea1c47850e80afe0cba2f3b596
