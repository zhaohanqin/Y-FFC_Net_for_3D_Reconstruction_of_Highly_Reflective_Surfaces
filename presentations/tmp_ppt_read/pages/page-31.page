    content:
      fontFamily: Calibri
      fontSize: 12
      color: '#0D9488'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">L2 输出特征</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  形状: [B, ~704, H/8, W/8]</span></p><p><span style="color:#475569;font-size:10px;font-family:Consolas">  组成: 384 + 256 + 64</span></p><p><span style="color:#475569;font-size:9.5px;font-family:Calibri">  = 解码主体 + gated x_bb_3 + enh2</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#7C3AED;font-size:12px;font-family:Calibri;font-weight:700">本级特点</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · 首次空间上采到 H/8</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · 首次启用三路先验门控</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · FFC_H8 在中层注入全局频域</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#DB2777;font-size:12px;font-family:Calibri;font-weight:700">去向</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  → Level 3 (H/4) FeatureExtractionB</span></p>'
    sourceLayout: b912c9d8f2828cb5a151651dfe884e39decc71a821cf67be5141a17961ba77a3
