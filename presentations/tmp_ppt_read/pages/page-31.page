  - elementId: slide-31-node-747-Text-13
    elementType: text
    bounds:
      - 363.6
      - 151.2
      - 280.8
      - 334.8
    content:
      fontFamily: Consolas
      fontSize: 10
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 空间上采 *2, 1408-&gt;384</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = TransposedConvBlock(L1_output)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   多分支 3x3/5x5/7x7 resize-conv</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># H/8 频域增强</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = FFC_H8(x)        # FFC_BN_ACT</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 三路先验调制 (* L2 开始有)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">g_8 = resize(g, H/8)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">s_8 = resize(s, H/8)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x_8 = resize(orig_x, H/8)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = x * (1</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a1 * grad_gate_2(g_8)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a2 * joint_gate_2(</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">              cat(g_8,x_8,s_8))</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a3 * spec_lik_gate_2(s_8))</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 高光感知 (sa2)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = SpecularAwareAttention(x, x_orig)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># Skip 门控 (att2)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">gated_xbb3 = Attention_block(x, x_bb_3)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 输出</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = cat(x, gated_xbb3, enh2)</span></p>'
    sourceLayout: 19c3cfb0da27d9fdfe148596049195f52801362bfc8403139e7612e7d5726fb8
