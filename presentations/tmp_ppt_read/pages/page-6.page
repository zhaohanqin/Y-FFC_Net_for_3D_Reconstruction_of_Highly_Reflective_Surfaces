    content:
      fontFamily: Calibri
      fontSize: 12
      color: '#1E2761'
      align:
        - left
        - top
      wrap: true
      text: <p><span style="color:#1E2761;font-size:12px;font-family:Calibri;font-weight:700">r · 最终漫反射</span></p><p><span style="color:#475569;font-size:10.5px;font-family:Calibri">    形状 [B,1,H,W], 推理主结果。</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#1E2761;font-size:12px;font-family:Calibri;font-weight:700">b · 镜面反射 / 高反光</span></p><p><span style="color:#475569;font-size:10.5px;font-family:Calibri">    形状 [B,1,H,W], 构成 r_sub 的依据。</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#1E2761;font-size:12px;font-family:Calibri;font-weight:700">g · 梯度图</span></p><p><span style="color:#475569;font-size:10.5px;font-family:Calibri">    形状 [B,1,H,W], 监督目标为 Sobel(input)。</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#1E2761;font-size:12px;font-family:Calibri;font-weight:700">s · 高光软概率</span></p><p><span style="color:#475569;font-size:10.5px;font-family:Calibri">    形状 [B,1,H,W], 监督目标 gt_specular。</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#1E2761;font-size:12px;font-family:Calibri;font-weight:700">r_direct · 直接预测漫反射</span></p><p><span style="color:#475569;font-size:10.5px;font-family:Calibri">    形状 [B,1,H,W], 参与训练损失与最终融合。</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#1E2761;font-size:12px;font-family:Calibri;font-weight:700">alpha · 双路融合系数</span></p><p><span style="color:#475569;font-size:10.5px;font-family:Calibri">    可学习标量/广播张量, 控制 r_direct 与 r_sub 比例。</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#1E2761;font-size:12px;font-family:Calibri;font-weight:700">cs · 跨尺度一致性</span></p><p><span style="color:#475569;font-size:10.5px;font-family:Calibri">    标量, 作用于 H/4、H/8、H/16 融合特征响应图, 仅参与训练损失。</span></p>
    sourceLayout: e93ccf40571dfbb4f56a9a894d67a6709ae7acf5d1a68e59dc22057268e0762a
