  - elementId: slide-43-node-949-Text-13
    elementType: text
    bounds:
      - 514.8
      - 151.2
      - 388.8
      - 313.2
    content:
      fontFamily: Consolas
      fontSize: 9
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">for (inp, tgt, gt_s, gt_g) in loader:</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    # 1) forward</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    out = model(inp)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    # out = {r, b, g, s, r_direct, alpha, cs}</span></p><p></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    # 2) loss</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    loss, sub = criterion(</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        pred_diffuse = out[&quot;r&quot;],</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        target       = tgt,</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        est_b        = out[&quot;b&quot;],</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        gt_specular  = gt_s,</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        pred_grad    = out[&quot;g&quot;],</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        gt_grad      = gt_g,</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        cross_scale_consistency = out[&quot;cs&quot;],</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        input_img    = inp,</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        pred_s_lik   = out[&quot;s&quot;],</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        pred_r_direct= out[&quot;r_direct&quot;])</span></p><p></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    # 3) NaN/Inf 检查 + 异常 batch 跳过</span></p><p></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    # 4) backward</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    (loss / ACCUMULATION_STEPS).backward()</span></p><p></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">    if (step+1) % ACCUMULATION_STEPS == 0:</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        clip_grad_norm_(params, GRAD_CLIP_VALUE)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        optimizer.step()</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        scheduler.step()</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        optimizer.zero_grad()</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">        ema.update()</span></p>'
    sourceLayout: 14f1decb139a540d3a22c4b74265c33c720a96662af9417559ffea08eb5613f6
