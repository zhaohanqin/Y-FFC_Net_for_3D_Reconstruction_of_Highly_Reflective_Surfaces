    content:
      fontFamily: Consolas
      fontSize: 9
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">YFFC  (主网络入口)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">├── Encoder                                   双分支多尺度编码器</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── ResNet50 (灰度适配, layer4 dilated)   → x_bb_1..4</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── SwinEncoderBranch (Swin-Tiny)         → swin_4 / swin_8 / swin_16</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── AdaptiveSkipFusion × 2 (H/4, H/8)     轻量门控融合 ResNet + Swin skip</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── CrossModalFusion (H/16)               双向 Cross-Attention + gate</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── CrossScaleTopDownRefinement           H/16 → H/8 → H/4 语义回流</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── cba_after_backbone                    Conv 1×1: 512 → 256</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── FFC_BN_ACT (ratio=0.5)         ★FFC★  瓶颈残差注入</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   └── HighFrequencyEnhancement              Laplacian + 可学习高频 + SE</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">├── GradientDecoder                           5 个 Block · 双输出头</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── fuse_global_context                   cat(x_bb_4, x_c) → 512ch</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── Block 1 (H/16): 7×7 → 1×1 → 3×3 → FFC_BN_ACT(r=0.25) ★FFC★</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── Block 2 (H/8) : 3×3 → FFC_BN_ACT(r=0.25) ★FFC★ → ConvT</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── Block 3 (H/4) : 3×3 → FFC_BN_ACT(r=0.25) ★FFC★ → ConvT</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── Block 4 (H/2) : 3×3 → ConvT</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── Block 5 (H)   : cat(xe4, x_bb_1) → ConvT → cat(shared, x)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── Grad Head     → Conv 3×3 → Sigmoid → g</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   └── Spec-Lik Head → 3×3 → 3×3 → 5×5 → Sigmoid → s</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">├── EnhancementLayers                         4 个 _SpectralDecompositionUnit</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   └── 每个单元: projection_branch (7×7) + specular_branch (3×3)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│                + FFC_BN_ACT ★FFC★ + Self-gate + edge_gate × spec_gate</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│                + β-受控残差注入 → enh1..4</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">├── MainDecoder                               5 级 · 双头输出</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── L1 (H/16): FFC1 + FFC2 ★FFC★ + Multiscale + sa1 + att1 + cat(enh1)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── L2 (H/8) : TransposedConvBlock + FFC_H8 ★FFC★ + 三路先验 + sa2 + att2 + cat(enh2)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── L3 (H/4) : FeatureExtractionB + TransposedConvBlock + FFC_H4 ★FFC★ + 三路先验 + sa3 + att3 + cat(enh3)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   ├── L4 (H/2) : TransposedConvBlock + 三路先验 + sa4 + att4 + cat(enh4)</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│   └── L5 (H)   : TransposedConvBlock → cat(g) → output_reduce/dilated → b_head + r_direct_head + alpha_logit</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">│</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">└── ResidualRefinementHead                    cat(r_fused, x, r_direct) → 24→16→1 → Tanh delta</span></p><p><span style="color:#E2E8F0;font-size:9px;font-family:Consolas">                                              r = clamp(r_fused + 0.15·delta)</span></p>'
    sourceLayout: d09535e92ffe107a8b57a6a4f4bc461703d39f2beef3240b4d874627a36b96c7
