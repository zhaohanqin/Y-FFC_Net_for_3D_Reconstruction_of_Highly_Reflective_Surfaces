    sourceLayout: bfea8570816e776661ec6b64c84f45ccc03ddfed9dcd7ad5ff1c2cf6bc72189a
  - elementId: slide-37-node-846-Text-14
    elementType: text
    bounds:
      - 532.8
      - 331.2
      - 381.6
      - 162
    content:
      fontFamily: Calibri
      fontSize: 11
      color: '#DB2777'
      align:
        - left
        - top
      wrap: true
      text: <p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">r_fused 是粗略结果, 仍可能在亮暗边界、过渡区域有不连续</span></p><p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">RefinementHead 同时看到 r_fused、原图 x、r_direct, 学习像素级微调量 delta</span></p><p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">Tanh 输出 delta ∈ [-1, 1]; 系数 0.15 限制实际修改幅度 ∈ [-0.15, 0.15]</span></p><p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">保留 r_fused 主体的同时, 仅做小幅细节修复, 避免推翻已有融合结果</span></p>
    sourceLayout: 738f77943d431d2550d21c59e51d8896613aeb878e7150d2999f44ec6427f743
