  - elementId: slide-37-node-842-Text-10
    elementType: text
    bounds:
      - 532.8
      - 140.4
      - 381.6
      - 144
    content:
      fontFamily: Calibri
      fontSize: 11
      color: '#0D9488'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#0D9488;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">r_sub 保留物理含义, 在亮区 b 可靠时是最优</span></p><p><span style="color:#0D9488;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">r_sub 的缺陷在 b 估计不准的暗区: x-b 会被 clamp 到 0, 暗部细节会丢</span></p><p><span style="color:#0D9488;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">r_direct 直接学习, 不依赖 b, 对暗区与复杂边界更鲁棒</span></p><p><span style="color:#0D9488;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">α 自适应选择, 不必硬性二选一</span></p>'
    sourceLayout: 149d6b7878a09f79f620bebeb1d5813250df8269ec403c25aee0077e698530f7
