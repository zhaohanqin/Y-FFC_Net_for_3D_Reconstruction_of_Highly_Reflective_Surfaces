  - elementId: slide-37-node-838-Text-6
    elementType: text
    bounds:
      - 46.8
      - 115.2
      - 446.4
      - 374.4
    content:
      fontFamily: Consolas
      fontSize: 10
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># YFFC.forward 末段 (在主解码器输出之后)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 1) 物理减法路径</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">r_sub = torch.clamp(x - b, 0.0, 1.0)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   x   : 原始输入</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   b   : 主解码器估计的高反光分量</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   含义: 漫反射 = 输入 - 镜面</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   优点: 物理可解释</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   缺点: 当 b 在暗区被低估时, x-b 会</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#         被 clamp 到 0, 丢失暗部细节</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 2) 直接预测路径</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">r_direct = decoder.r_direct_head(...)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   绕过减法链, 由网络直接学习漫反射</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   在 b 估计不准的暗区/复杂区起兜底作用</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 3) 双路融合</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">alpha = torch.sigmoid(alpha_logit)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">r_fused = alpha * r_direct + (1-alpha) * r_sub</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   alpha 可学习, 让网络自适应选择两路比例</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 4) 残差精修</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">delta = refinement_head(r_fused, x, r_direct)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   ResidualRefinementHead 内部:</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   cat([r_fused, x, r_direct]) -&gt; 3 通道</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   Conv3x3 -&gt; 24ch -&gt; GELU</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   轻量残差块 24-&gt;24-&gt;24</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   GELU -&gt; Conv 24-&gt;16 -&gt; Conv 16-&gt;1 + Tanh</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   delta in [-1, 1]</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 5) 最终输出 (clamp 限幅 + 系数缩放)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">r = torch.clamp(r_fused + 0.15 * delta, 0, 1)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   0.15 是受控强度系数, 防止精修头过度修改</span></p>'
    sourceLayout: c8de50f5f576452b1365492b138016044ac9bbdaa8d38ce3db1ec615f2bdd0ae
