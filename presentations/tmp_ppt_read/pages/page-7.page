  - elementId: slide-7-node-166-Text-6
    elementType: text
    bounds:
      - 46.8
      - 115.2
      - 518.4
      - 381.6
    content:
      fontFamily: Consolas
      fontSize: 9.5
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas"># YFFC.forward(x)  ----  x in [B, 1, H, W]</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas"># (1) Encoder: 5 路特征</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">x_bb_1, x_bb_2, x_bb_3, x_bb_4, x_c = encoder(x)</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">#   x_bb_1 [B, 64, H/2 , W/2 ]</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">#   x_bb_2 [B,128, H/4 , W/4 ]</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">#   x_bb_3 [B,256, H/8 , W/8 ]</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">#   x_bb_4 [B,512, H/16, W/16]</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">#   x_c    [B,256, H/16, W/16]</span></p><p></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas"># (2) GradientDecoder: 辅助分支输出</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">xe1, xe2, xe3, xe4, g, s = \</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">    gradient_decoder((x_bb_1..4), x_c, x)</span></p><p></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas"># (3) EnhancementLayers: 增强桥接</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">enh1, enh2, enh3, enh4 = \</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">    enhancement_layers((xe1..4), g, x, s)</span></p><p></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas"># (4) MainDecoder: 双头输出</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">b, r_direct, alpha_logit = main_decoder(</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">    (x_bb_1..4, x_c), (enh1..4), g, s, x)</span></p><p></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas"># (5) 双路融合 + 残差精修</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">r_sub   = clamp(x - b, 0, 1)</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">alpha   = sigmoid(alpha_logit)</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">r_fused = alpha * r_direct + (1 - alpha) * r_sub</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">delta   = refinement_head(r_fused, x, r_direct)</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">r       = clamp(r_fused + 0.15 * delta, 0, 1)</span></p><p></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas"># (6) 跨尺度一致性 (仅训练)</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">cs = cross_scale_consistency(x_bb_2, x_bb_3, x_bb_4)</span></p><p></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">return {&quot;r&quot;: r, &quot;b&quot;: b, &quot;g&quot;: g, &quot;s&quot;: s,</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">        &quot;r_direct&quot;: r_direct,</span></p><p><span style="color:#E2E8F0;font-size:9.5px;font-family:Consolas">        &quot;alpha&quot;: alpha, &quot;cs&quot;: cs}</span></p>'
    sourceLayout: c3f200a10616adfac35481ee62670550c00cffed231cfdb8fb7971c683dff456
