  - elementId: slide-33-node-785-Text-13
    elementType: text
    bounds:
      - 363.6
      - 151.2
      - 280.8
      - 334.8
    content:
      fontFamily: Consolas
      fontSize: 10
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 空间上采 *2</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = TransposedConvBlock(L3_out)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   -&gt; 96 通道, H/2 分辨率</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   注意: 本级不再使用 FFC</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#         (浅层依赖空间局部性)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 三路先验调制</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">g_2 = resize(g, H/2)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">s_2 = resize(s, H/2)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x_2 = resize(orig_x, H/2)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = x * (1</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a1 * grad_gate_4(g_2)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a2 * joint_gate_4(</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">              [g_2,x_2,s_2])</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a3 * spec_lik_gate_4(s_2))</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># 高光感知 sa4</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = SpecularAwareAttention(x, x_orig)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># Skip 门控 att4</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">gated_xbb1 = Attention_block(x, x_bb_1)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># cat 三路特征</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = cat(x, gated_xbb1, enh4)</span></p>'
    sourceLayout: ecd02feed9f6b258162fdb3ba4477db678b0f7be03f6b5b1cb17895c7c4907c4
