      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">L3 输出特征</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  形状: [B, ~352, H/4, W/4]</span></p><p><span style="color:#475569;font-size:10px;font-family:Consolas">  组成: 192 + 128 + 32</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#7C3AED;font-size:12px;font-family:Calibri;font-weight:700">本级特点</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · H/4 是条纹细节关键尺度</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · 4 路 FeatureExtractionB 提供多视野</span></p><p><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  · FFC_H4 保留频域全局感受野</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#DB2777;font-size:12px;font-family:Calibri;font-weight:700">去向</span><span style="color:#1F2937;font-size:10.5px;font-family:Calibri">  → Level 4 (H/2) TransposedConvBlock ↑×2</span></p>'
    sourceLayout: 385ec8245e39fdf095ee11d4bb7eb056f4e984f1e2707bbd64d11014edf4df17
