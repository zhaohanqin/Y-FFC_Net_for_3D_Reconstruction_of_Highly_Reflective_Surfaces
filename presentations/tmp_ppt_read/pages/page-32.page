      text: <p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">L2 输出</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, ~704, H/8, W/8]</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#0D9488;font-size:12px;font-family:Consolas;font-weight:700">x_bb_2</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 128, H/4, W/4]</span></p><p><span style="color:#475569;font-size:10px;font-family:Calibri">    Encoder H/4 skip (已经过 ASF 与 TopDown)</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#10B981;font-size:12px;font-family:Consolas;font-weight:700">enh3</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  [B, 32, H/4, W/4]</span></p><p><span style="color:#000000;font-size:5px;font-family:Calibri"> </span></p><p><span style="color:#DB2777;font-size:12px;font-family:Consolas;font-weight:700">g, s, x</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">  → resize 到 H/4</span></p>
