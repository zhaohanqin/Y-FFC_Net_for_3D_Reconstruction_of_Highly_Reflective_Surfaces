  - elementId: slide-32-node-766-Text-13
    elementType: text
    bounds:
      - 363.6
      - 151.2
      - 280.8
      - 334.8
    content:
      fontFamily: Consolas
      fontSize: 10
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: <p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># (1) 多分支特征提取</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = FeatureExtrationLayersB(L2_out)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   4 路 conv 分支 cat</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   -&gt; 640 通道</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># (2) 空间上采 *2</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = TransposedConvBlock(x)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">#   -&gt; 192 通道, H/4 分辨率</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># (3) H/4 频域增强</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = FFC_H4(x)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># (4) 三路先验调制</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">g_4 = resize(g, H/4)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">s_4 = resize(s, H/4)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x_4 = resize(orig_x, H/4)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = x * (1</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a1 * grad_gate_3(g_4)</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a2 * joint_gate_3(</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">              [g_4,x_4,s_4])</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">       + a3 * spec_lik_gate_3(s_4))</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># (5) 高光感知 sa3</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = SpecularAwareAttention(x, x_orig)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># (6) Skip 门控 att3</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">gated_xbb2 = Attention_block(x, x_bb_2)</span></p><p></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas"># (7) cat 三路特征</span></p><p><span style="color:#E2E8F0;font-size:10px;font-family:Consolas">x = cat(x, gated_xbb2, enh3)</span></p>
    sourceLayout: 194e227b604c7186a58c8027affd365d6ce364d57904b8e95fee6a144ad2c70d
