  - elementId: slide-35-node-822-Text-12
    elementType: text
    bounds:
      - 504
      - 147.6
      - 410.4
      - 345.6
    content:
      fontFamily: Calibri
      fontSize: 12
      color: '#0D9488'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">位置</span><span style="color:#1F2937;font-size:11px;font-family:Calibri">    主解码器各级的 Encoder skip 注入前: att1 门控 x_bb_4、att2 门控 x_bb_3、att3 门控 x_bb_2、att4 门控 x_bb_1。</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">输入</span><span style="color:#1F2937;font-size:11px;font-family:Calibri">    g = 当前解码特征 (Gate Signal); x = 来自 Encoder 的 skip 特征。</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">计算流程</span><span style="color:#1F2937;font-size:11px;font-family:Consolas">    g_proj = BN(Conv 1×1 (g))</span></p><p><span style="color:#1F2937;font-size:11px;font-family:Consolas">    x_proj = BN(Conv 1×1 (x))</span></p><p><span style="color:#1F2937;font-size:11px;font-family:Consolas">    psi = sigmoid(BN(Conv 1×1 (ReLU(g_proj + x_proj))))</span></p><p><span style="color:#1F2937;font-size:11px;font-family:Consolas">    output = x · psi   (逐通道独立)</span></p><p><span style="color:#000000;font-size:4px;font-family:Calibri"> </span></p><p><span style="color:#0D9488;font-size:12px;font-family:Calibri;font-weight:700">关键设计</span><span style="color:#1F2937;font-size:11px;font-family:Calibri">    与单通道注意力不同, psi 是 F_l 通道, 每个 skip 通道都有独立权重, 可以选择性放大/抑制不同特征。例如在高光区抑制条纹边缘 skip, 在条纹清晰区强化结构 skip。</span></p>'
    sourceLayout: 4d5a846bbb3e85dcd7d63997719985421eb672725dc34cecf091a4a728cae4e8
