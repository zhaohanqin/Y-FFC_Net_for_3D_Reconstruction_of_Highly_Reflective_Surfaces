  - elementId: slide-13-node-320-Text-14
    elementType: text
    bounds:
      - 532.8
      - 331.2
      - 381.6
      - 162
    content:
      fontFamily: Calibri
      fontSize: 11
      color: '#DB2777'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">Laplacian 分支 (固定核): 提取二阶导, 对条纹边缘敏感</span></p><p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">可学习高频分支: 数据驱动捕获非 Laplacian 高频</span></p><p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">SE 通道注意力: 自动选择真正重要的高频分量</span></p><p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">受控残差缩放: output = x + gamma · SE(fusion(...)), 避免破坏整体表示</span></p><p><span style="color:#DB2777;font-size:11px;font-family:Calibri">·  </span><span style="color:#1F2937;font-size:11px;font-family:Calibri">意义: 高光边界与条纹本身都是强高频信号; 显式增强避免被深层卷积平滑掉</span></p>'
    sourceLayout: 036bd1a1b32e84ca5ca28f5b1878c7b7b6bf3daa864c4171f2b27b921bfc3149
