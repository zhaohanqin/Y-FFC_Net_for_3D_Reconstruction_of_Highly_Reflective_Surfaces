  - elementId: slide-13-node-312-Text-6
    elementType: text
    bounds:
      - 46.8
      - 115.2
      - 446.4
      - 374.4
    content:
      fontFamily: Consolas
      fontSize: 11
      color: '#E2E8F0'
      align:
        - left
        - top
      wrap: true
      text: '<p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># Encoder 末端流程 (在 forward 中的实际位置)</span></p><p></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># 已经得到 H/16 融合特征 x_bb_4 [B,512,H/16,W/16]</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># 以及顶向回流的精炼版本</span></p><p></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># (1) 通道压缩 + 投影</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">x_c = cba_after_backbone(x_bb_4)</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># x_c [B, 256, H/16, W/16]</span></p><p></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># (2) FFC 瓶颈 (频域全局建模)</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">ffc_out = FFC_BN_ACT(x_c,</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">                     ratio_gin=0.5,</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">                     ratio_gout=0.5)</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">x_c = x_c + ffc_out          # 残差</span></p><p></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># (3) 高频显式增强</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">hf = HighFrequencyEnhancement(x_c)</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">#  内部:</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">#  · 固定 Laplacian 分支 (二阶边缘)</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">#  · 可学习高频分支</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">#  · 多尺度 (sigma=1,3,5) 高斯-残差</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">#  · SE 通道注意力</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">x_c = x_c + gamma * hf       # gamma 受控</span></p><p></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># (4) 数值保护</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas">x_c = _safe_tensor(x_c)</span></p><p></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># x_c 进入 GradientDecoder Block 1</span></p><p><span style="color:#E2E8F0;font-size:11px;font-family:Consolas"># 与 MainDecoder L1</span></p>'
    sourceLayout: 262dba2fdb599a36b511d6fa2695fee9ffa76d36a98ba11a556cca0a2fb9dbd0
